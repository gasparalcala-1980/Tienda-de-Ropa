rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Catálogo de productos: lectura y escritura (crear, editar, eliminar)
    match /products/{productId} {
      allow read, write: if true;
    }

    // 2. Fichas de crédito de clientes: lectura y administración
    match /creditClients/{clientId} {
      allow read, write: if true;
    }

    // 3. Configuración de tienda y tasa BCV
    match /storeSettings/{settingId} {
      allow read, write: if true;
    }
  }
}
